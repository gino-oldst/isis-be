<xsd:schema id="BloombergChat" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <xsd:element name="FileDump">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="Conversation" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="Conversation">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="RoomID" type="xsd:string"/>
                <xsd:element name="StartTimeUTC" type="xsd:long"/>
                <xsd:element name="EndTimeUTC" type="xsd:long"/>
                <xsd:element ref="Message" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="Message">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="ConversationID" type="xsd:string"/>
                <xsd:element name="Content" type="xsd:string"/>
                <xsd:element name="DateTimeUTC" type="xsd:long"/>
                <xsd:element ref="User"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="User">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="LoginName" type="xsd:string"/>
                <xsd:element name="FirstName" type="xsd:string"/>
                <xsd:element name="LastName" type="xsd:string"/>
                <xsd:element name="UUID" type="xsd:string"/>
                <xsd:element name="FirmNumber" type="xsd:string"/>
                <xsd:element name="AccountNumber" type="xsd:string"/>
                <xsd:element name="CompanyName" type="xsd:string"/>
                <xsd:element name="EmailAddress" type="xsd:string"/>
                <xsd:element name="CorporateEmailAddress" type="xsd:string"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>